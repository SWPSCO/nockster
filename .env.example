# Nockster Wallet Environment Configuration Example
# Copy this file to .env and update with your values

# RPC Configuration
VITE_RPC_URL=https://nockblocks.com/rpc

# Network Configuration
VITE_NETWORK_NAME=Nockchain
VITE_CHAIN_ID=nockchain-mainnet

# Development Settings
VITE_DEBUG=false
VITE_AUTO_CONNECT=true
