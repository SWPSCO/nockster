{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local wallet window with persistent ciphertext, device control, Nockblocks access, and signed firmware downloads.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://nockblocks.com/**"
        },
        {
          "url": "https://bin.aeroe.io/nockster/updates/**"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://nockblocks.com/**"
        },
        {
          "url": "https://basescan.org/**"
        },
        {
          "url": "https://github.com/**"
        },
        {
          "url": "https://nockster.com/**"
        },
        {
          "url": "https://swps.io/**"
        },
        {
          "url": "https://my.nockster.com/manual/**"
        }
      ]
    }
  ]
}
